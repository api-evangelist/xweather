          "name": "Get Lightning Strike Data",
          "request": {
            "name": "Get Lightning Strike Data",
            "description": {
              "content": "Returns global lightning strike data including type, location, polarity, and amperage for the last 5 minutes.",
              "type": "text/plain"
            },
            "url": {
