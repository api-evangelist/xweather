              "name": "Get Lightning Strike Data",
              "id": "673c55e3-2d4e-4292-be47-da9f2dbf0cf4",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/lightning/:location?client_id=<string>&client_secret=<string>&radius=<string>&limit=<integer>&fields=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "lightning",
                    ":location"
                  ],
                  "query": [
                    {
                      "description": "(Required) Your Xweather API client ID.",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Your Xweather API client secret.",
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "description": "Radius for nearby strikes (e.g., \"25mi\" or \"40km\").",
                      "key": "radius",
                      "value": "<string>"
                    },
                    {
                      "description": "Maximum number of lightning strikes to return.",
                      "key": "limit",
                      "value": "<integer>"
                    },
                    {
                      "description": "Comma-separated list of fields to return.",
                      "key": "fields",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "d924b7f4-1885-4db5-a3c0-aeb6ecfb5222",
                      "key": "location",
                      "value": "<string>",
                      "description": "(Required) Location identifier or radius query (e.g., \"40.7128,-74.0060\" or \"closest:20:40.7128,-74.0060\")."
                    }
                  ]
                },
                "description": "Returns global lightning strike data including type, location, polarity, and amperage for the last 5 minutes."
